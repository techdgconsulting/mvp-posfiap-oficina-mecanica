@startuml deploy-flow
!theme plain
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam ArrowColor #1F2937
skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam packageStyle rectangle

left to right direction

actor "Developer / Maintainer" as dev
rectangle "GitHub Repository" as repo
rectangle "Infra Workflow\ninfra.yml" as infraWorkflow
rectangle "App Workflow\napp-cd.yml" as appWorkflow
rectangle "Terraform" as tf
rectangle "S3 State Backend" as s3
rectangle "AWS" as aws
rectangle "VPC / EKS / RDS / ECR / IAM" as infra
rectangle "Docker Build" as docker
rectangle "Amazon ECR" as ecr
rectangle "Kubernetes Cluster" as eks
rectangle "Namespace oficina" as ns
rectangle "ConfigMap + Secret" as k8sconf
rectangle "Deployment oficina-api" as deploy
rectangle "Service LoadBalancer" as svc
rectangle "Swagger / API" as api

dev --> repo : push / merge / dispatch
repo --> infraWorkflow : infra/** ou dispatch manual
repo --> appWorkflow : src / k8s / Dockerfile / pom.xml

infraWorkflow --> s3 : cria/garante backend
infraWorkflow --> tf : terraform init / plan / apply
tf --> s3 : read/write state
s3 --> tf : terraform.tfstate remote
tf --> infra : provisiona infraestrutura
infra --> aws : VPC, EKS, RDS, ECR, IAM

appWorkflow --> tf : terraform output
tf --> s3 : read state
s3 --> appWorkflow : ECR, EKS, JDBC URL

appWorkflow --> docker : mvn test + docker build
docker --> ecr : push image versionada
appWorkflow --> eks : aws eks update-kubeconfig
appWorkflow --> ns : create namespace
appWorkflow --> k8sconf : create/update config e secret
appWorkflow --> deploy : kubectl apply -k k8s
deploy --> eks : deployment oficina-api
deploy --> svc : expoe API via LoadBalancer
svc --> api : http://host/swagger-ui.html

api --> aws : acesso ao banco no RDS via JDBC
aws --> infra : RDS PostgreSQL

note right of infraWorkflow
  Infra workflow:
  1) prepara S3 backend
  2) executa Terraform
  3) cria/atualiza AWS
end note

note right of appWorkflow
  App workflow:
  1) testa app
  2) le outputs da infra
  3) constroi imagem
  4) publica no ECR
  5) aplica Kubernetes
  6) atualiza deployment
end note
@enduml
